# Settings for this repository's self-hosted runner kit. Commit this file; it holds no secret.
# register.sh, host-maintenance.sh and docker-compose.yml all read it. Change every value
# marked "change me" before the first ./register.sh.

# The repository the runners serve, as owner/name. Change me.
RUNNER_REPO=owner/name

# A short name, unique on the Docker host, that keeps this repository's containers, work
# directories and Compose project apart from other repositories' runners. Change me.
RUNNER_PREFIX=myrepo

# The Docker context the runners use: colima on a Mac, default on a Linux VM. A value set in
# the environment, such as the systemd unit's, takes precedence over this one.
RUNNER_DOCKER_CONTEXT=colima

# The Colima profile whose disk use host-maintenance.sh reports.
RUNNER_COLIMA_PROFILE=default

# Leaked test containers that host-maintenance.sh removes once they're older than
# LEAK_HOURS. LEAK_LABELS are container labels that your test harness sets on its disposable
# containers. LEAK_IMAGES are images whose containers are removed only when no Compose project
# owns them. Separate entries with spaces; leave a list empty to skip it. Change me.
LEAK_LABELS=""
LEAK_IMAGES=""
LEAK_HOURS=6
